{
    "dataRoles": [
        {
            "displayName": "Date Column",
            "displayNameKey": "Role_DateColumn",
            "name": "dateColumn",
            "kind": "Grouping",
            "description": "DT_DATE[Date_D]"
        },
        {
            "displayName": "Granularity Column (optional)",
            "displayNameKey": "Role_GranColumn",
            "name": "granColumn",
            "kind": "Grouping",
            "description": "Physical column with granularity codes (D/W/M/Q/S/Y), e.g. AUX_PERIOD[Aux_Period]. Can be an ordinary small disconnected table \u2014 no cartesian join or special shaping needed. When bound, granularity becomes part of the same real, cross-page-synced filter as the date range. When left unbound, the selector still works fully; granularity is just UI-only (no filter sent for it specifically).",
            "descriptionKey": "Role_GranColumn_Desc"
        },
        {
            "displayName": "Language",
            "displayNameKey": "Role_Language",
            "name": "langMeasure",
            "kind": "Measure",
            "description": "AUX_LANGUAGE[_SELECTED_LANG]"
        },
        {
            "displayName": "Reference Date (optional)",
            "displayNameKey": "Role_RefDate",
            "name": "refDateMeasure",
            "kind": "Measure",
            "description": "Optional measure for reference date. Use CALCULATE(MAX(DT_DATE[Date_D]), ALL()) to ensure stable value across pages."
        }
    ],
