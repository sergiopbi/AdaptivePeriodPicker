{
    "dataRoles": [
        {
            "displayName": "Date Column",
            "displayNameKey": "Role_DateColumn",
            "name": "dateColumn",
            "kind": "Grouping",
            "description": "DT_DATE[Date_D]"
        },
        {
            "displayName": "Granularity Column (optional)",
            "displayNameKey": "Role_GranColumn",
            "name": "granColumn",
            "kind": "Grouping",
            "description": "Physical column with granularity codes (D/W/M/Q/S/Y), e.g. AUX_PERIOD[Aux_Period]. Can be an ordinary small disconnected table — no cartesian join or special shaping needed. When bound, granularity becomes part of the same real, cross-page-synced filter as the date range. When left unbound, the selector still works fully; granularity is just UI-only (no filter sent for it specifically).",
            "descriptionKey": "Role_GranColumn_Desc"
        },
        {
            "displayName": "Language",
            "displayNameKey": "Role_Language",
            "name": "langMeasure",
            "kind": "Measure",
            "description": "AUX_LANGUAGE[_SELECTED_LANG]"
        },
        {
            "displayName": "Reference Date (optional)",
            "displayNameKey": "Role_RefDate",
            "name": "refDateMeasure",
            "kind": "Measure",
            "description": "Optional measure for reference date. Use CALCULATE(MAX(DT_DATE[Date_D]), ALL()) to ensure stable value across pages."
        }
    ],
    "objects": {
        "general": {
            "properties": {
                "filter": {
                    "type": {
                        "filter": {}
                    }
                },
                "state": {
                    "type": {
                        "text": true
                    }
                }
            }
        },
        "dataColors": {
            "displayName": "Cores",
            "displayNameKey": "Card_DataColors",
            "properties": {
                "backgroundColor": {
                    "displayName": "Fundo principal",
                    "displayNameKey": "Prop_BackgroundColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "panelColor": {
                    "displayName": "Fundo de caixas / inputs",
                    "displayNameKey": "Prop_PanelColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "accentColor": {
                    "displayName": "Cor de destaque",
                    "displayNameKey": "Prop_AccentColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "titleColor": {
                    "displayName": "Cor de títulos / setas / texto secundário",
                    "displayNameKey": "Prop_TitleColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "valueColor": {
                    "displayName": "Cor de valores / texto principal",
                    "displayNameKey": "Prop_ValueColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "accentTextColor": {
                    "displayName": "Texto sobre a cor de destaque",
                    "displayNameKey": "Prop_AccentTextColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        },
        "border": {
            "displayName": "Rebordo",
            "displayNameKey": "Card_Border",
            "properties": {
                "borderColor": {
                    "displayName": "Cor do rebordo",
                    "displayNameKey": "Prop_BorderColor",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "borderWidth": {
                    "displayName": "Espessura do rebordo (px)",
                    "displayNameKey": "Prop_BorderWidth",
                    "type": {
                        "numeric": true
                    }
                }
            }
        },
        "displayMode": {
            "displayName": "Modo de Exibição",
            "displayNameKey": "Card_DisplayMode",
            "properties": {
                "layoutMode": {
                    "displayName": "Modo de exibição",
                    "displayNameKey": "Prop_LayoutMode",
                    "type": {
                        "enumeration": [
                            {
                                "displayName": "Pop-up",
                                "displayNameKey": "Enum_Popup",
                                "value": "popup"
                            },
                            {
                                "displayName": "Inline Vertical",
                                "displayNameKey": "Enum_InlineVertical",
                                "value": "inline-vertical"
                            },
                            {
                                "displayName": "Inline Horizontal",
                                "displayNameKey": "Enum_InlineHorizontal",
                                "value": "inline-horizontal"
                            }
                        ]
                    }
                },
                "applyMode": {
                    "displayName": "Modo de aplicação",
                    "displayNameKey": "Prop_ApplyMode",
                    "type": {
                        "enumeration": [
                            {
                                "value": "immediate",
                                "displayName": "Imediato",
                                "displayNameKey": "Enum_Immediate"
                            },
                            {
                                "value": "confirm",
                                "displayName": "Confirmar",
                                "displayNameKey": "Enum_Confirm"
                            }
                        ]
                    }
                }
            }
        },
        "defaultPeriod": {
            "displayName": "Período Predefinido",
            "displayNameKey": "Card_DefaultPeriod",
            "properties": {
                "defaultType": {
                    "displayName": "Período predefinido",
                    "displayNameKey": "Prop_DefaultType",
                    "type": {
                        "enumeration": [
                            { "value": "today", "displayName": "today", "displayNameKey": "Enum_Today" },
                            { "value": "yesterday", "displayName": "yesterday", "displayNameKey": "Enum_Yesterday" },
                            { "value": "thisWeek", "displayName": "thisWeek", "displayNameKey": "Enum_ThisWeek" },
                            { "value": "lastWeek", "displayName": "lastWeek", "displayNameKey": "Enum_LastWeek" },
                            { "value": "thisMonth", "displayName": "thisMonth", "displayNameKey": "Enum_ThisMonth" },
                            { "value": "mtd", "displayName": "mtd", "displayNameKey": "Enum_Mtd" },
                            { "value": "qtd", "displayName": "qtd", "displayNameKey": "Enum_Qtd" },
                            { "value": "ytd", "displayName": "ytd", "displayNameKey": "Enum_Ytd" },
                            { "value": "thisQuarter", "displayName": "thisQuarter", "displayNameKey": "Enum_ThisQuarter" },
                            { "value": "thisSemester", "displayName": "thisSemester", "displayNameKey": "Enum_ThisSemester" },
                            { "value": "thisYear", "displayName": "thisYear", "displayNameKey": "Enum_ThisYear" },
                            { "value": "dynamic", "displayName": "dynamic", "displayNameKey": "Enum_Dynamic" }
                        ]
                    }
                }
            }
        },
        "shortcuts": {
            "displayName": "Atalhos Visíveis",
            "displayNameKey": "Card_Shortcuts",
            "properties": {
                "scToday": { "displayName": "scToday", "displayNameKey": "Prop_ScToday", "type": { "bool": true } },
                "scYesterday": { "displayName": "scYesterday", "displayNameKey": "Prop_ScYesterday", "type": { "bool": true } },
                "scThisWeek": { "displayName": "scThisWeek", "displayNameKey": "Prop_ScThisWeek", "type": { "bool": true } },
                "scLastWeek": { "displayName": "scLastWeek", "displayNameKey": "Prop_ScLastWeek", "type": { "bool": true } },
                "scThisMonth": { "displayName": "scThisMonth", "displayNameKey": "Prop_ScThisMonth", "type": { "bool": true } },
                "scMtd": { "displayName": "scMtd", "displayNameKey": "Prop_ScMtd", "type": { "bool": true } },
                "scQtd": { "displayName": "scQtd", "displayNameKey": "Prop_ScQtd", "type": { "bool": true } },
                "scYtd": { "displayName": "scYtd", "displayNameKey": "Prop_ScYtd", "type": { "bool": true } },
                "scThisQuarter": { "displayName": "scThisQuarter", "displayNameKey": "Prop_ScThisQuarter", "type": { "bool": true } },
                "scThisSemester": { "displayName": "scThisSemester", "displayNameKey": "Prop_ScThisSemester", "type": { "bool": true } },
                "scThisYear": { "displayName": "scThisYear", "displayNameKey": "Prop_ScThisYear", "type": { "bool": true } },
                "scDynamic": { "displayName": "scDynamic", "displayNameKey": "Prop_ScDynamic", "type": { "bool": true } }
            }
        },
        "granularityOptions": {
            "displayName": "Granularidades Visíveis",
            "displayNameKey": "Card_GranularityOptions",
            "properties": {
                "granD": { "displayName": "Diário (D)", "displayNameKey": "Prop_GranD", "type": { "bool": true } },
                "granW": { "displayName": "Semanal (W)", "displayNameKey": "Prop_GranW", "type": { "bool": true } },
                "granM": { "displayName": "Mensal (M)", "displayNameKey": "Prop_GranM", "type": { "bool": true } },
                "granQ": { "displayName": "Trimestral (Q)", "displayNameKey": "Prop_GranQ", "type": { "bool": true } },
                "granS": { "displayName": "Semestral (S)", "displayNameKey": "Prop_GranS", "type": { "bool": true } },
                "granY": { "displayName": "Anual (Y)", "displayNameKey": "Prop_GranY", "type": { "bool": true } }
            }
        }
    },
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "dateColumn": { "max": 1 },
                    "langMeasure": { "max": 1 },
                    "refDateMeasure": { "max": 1 },
                    "granColumn": { "max": 1 }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        { "for": { "in": "dateColumn" } },
                        { "for": { "in": "granColumn" } }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 30000
                        }
                    }
                },
                "values": {
                    "select": [
                        { "bind": { "to": "langMeasure" } },
                        { "bind": { "to": "refDateMeasure" } }
                    ]
                }
            }
        }
    ],
    "privileges": [],
    "supportsEmptyDataView": true,
    "suppressDefaultTitle": true,
    "supportsSynchronizingFilterState": true,
    "supportsLandingPage": true,
    "supportsKeyboardFocus": true,
    "tooltips": {
        "supportedTypes": {
            "default": true,
            "canvas": true
        },
        "supportEnhancedTooltips": true
    }
}
