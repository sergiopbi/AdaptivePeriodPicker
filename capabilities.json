        "granularityOptions": {
            "displayName": "Granularidades Vis\u00edveis",
            "displayNameKey": "Card_GranularityOptions",
            "properties": {
                "autoGranularity": {
                    "displayName": "Granularidade autom\u00e1tica",
                    "displayNameKey": "Prop_AutoGranularity",
                    "description": "Ligado: a granularidade escolhida acima \u00e9 s\u00f3 uma sugest\u00e3o \u2014 se o intervalo selecionado tiver poucos pontos nesse n\u00edvel (ou esse n\u00edvel estiver desligado), desce automaticamente para o pr\u00f3ximo n\u00edvel dispon\u00edvel. A grelha mostrada nunca muda sozinha; s\u00f3 o filtro efetivo enviado aos outros visuais \u00e9 que pode ser diferente do n\u00edvel clicado. Desligado: for\u00e7a sempre o n\u00edvel escolhido, sem downgrade nenhum.",
                    "descriptionKey": "Prop_AutoGranularity_Desc",
                    "type": {
                        "bool": true
                    }
                },
                "showAutoGranToggle": {
                    "displayName": "Mostrar interruptor Autom\u00e1tico/Manual ao utilizador",
                    "displayNameKey": "Prop_ShowAutoGranToggle",
                    "description": "Mostra, dentro do pr\u00f3prio seletor, um interruptor que permite a quem v\u00ea o relat\u00f3rio trocar entre granularidade autom\u00e1tica e manual. A escolha n\u00e3o fica gravada \u2014 reinicia sempre no valor de \"Granularidade autom\u00e1tica\" acima ao reabrir o relat\u00f3rio.",
                    "descriptionKey": "Prop_ShowAutoGranToggle_Desc",
                    "type": {
                        "bool": true
                    }
                },
                "granD": {
                    "displayName": "Di\u00e1rio (D)",
