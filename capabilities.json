  "dataViewMappings": [
    {
      "conditions": [
        {
          "dateColumn": {
            "max": 1
          },
          "langMeasure": {
            "max": 1
          },
          "refDateMeasure": {
            "max": 1
          },
          "granColumn": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "dateColumn"
              }
            },
            {
              "for": {
                "in": "granColumn"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "langMeasure"
              }
            },
            {
              "bind": {
                "to": "refDateMeasure"
              }
            }
          ]
        }
      }
    }
  ],
  "privileges": [],
  "supportsEmptyDataView": true,
  "suppressDefaultTitle": true,
  "supportsSynchronizingFilterState": true,
  "supportsLandingPage": true,
  "supportsKeyboardFocus": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "supportEnhancedTooltips": true
  }
