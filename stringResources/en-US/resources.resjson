    "Prop_GranQ": "Quarterly (Q)",
    "Prop_GranQThreshold": "Q — minimum quarters",
    "Prop_GranS": "Semi-annual (S)",
    "Prop_GranSThreshold": "S — minimum semesters",
    "Prop_GranY": "Annual (Y)",
    "Prop_GranYThreshold": "Y — minimum years"
