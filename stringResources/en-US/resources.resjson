    "Card_DisplayMode": "Display Mode",
    "Prop_LayoutMode": "Display mode",
    "Prop_LayoutMode_Desc": "Pop-up: opens a native Power BI dialog on click (may show a 'don't show again' warning). Inline Vertical: calendar always visible, column layout. Inline Horizontal: calendar always visible, row layout — designed for wide, short bars at the top of the page.",
    "Enum_Popup": "Pop-up",
    "Enum_InlineVertical": "Inline Vertical",
    "Enum_InlineHorizontal": "Inline Horizontal",
    "Prop_ApplyMode": "Apply mode",
    "Prop_HoverExpand": "Show only on hover",
    "Prop_LockResizers": "Lock sizes (drag dividers)",
    "Prop_LockResizers_Desc": "Adjust the drag dividers (shortcuts, calendar, Start/End, etc.) while this is off; once you're happy with the sizes, turn it on to lock them in place — dividers stop responding to dragging or double-click, both for you and anyone viewing the published report. Exception: the shortcuts panel's divider always stays free, even with this on.",
    "Prop_ApplyMode_Desc": "Immediate: clicking a shortcut (or the 2nd click of a manual selection) applies the filter right away, no buttons. Confirm: shows Apply/Cancel buttons and the filter is only applied on confirmation.",
    "Prop_PopupWidth": "Pop-up width (px)",
    "Prop_PopupWidth_Desc": "Only applies in Pop-up mode. The absolute minimum allowed by Power BI is 240px, but below ~380px the shortcuts sidebar and calendar grid in this dialog start not fitting, and horizontal scroll can reappear.",
    "Prop_PopupHeight": "Pop-up height (px)",
    "Prop_PopupHorizontalAnchor": "Pop-up opening side",
    "Enum_AnchorRight": "Right (from the visual)",
    "Enum_AnchorLeft": "Left (from the visual)",
    "Enum_Immediate": "Immediate",
    "Enum_Confirm": "Confirm",

    "Card_DefaultPeriod": "Default Period",
    "Prop_DefaultType": "Default period",
    "Prop_DefaultType_Desc": "Sets the period applied by the refresh button (⟳). 'Last N' uses the number below, sensitive to granularity.",
